#!/usr/bin/env bash
# Fail if the diff base...head touches anything outside demos/<name>/.
set -euo pipefail

name="${1:-}" base="${2:-}" head="${3:-}"
if [[ ! "$name" =~ ^[a-z][-a-z0-9]{0,22}[a-z0-9]$ || -z "$base" || -z "$head" ]]; then
  echo "usage: scripts/check-paths <name> <base> <head>   (name must match ^[a-z][-a-z0-9]{0,22}[a-z0-9]\$)" >&2
  exit 2
fi

# --no-renames lists both sides of a move, so moving another demo's file in is caught.
bad="$(git diff --no-renames --name-only "$base...$head" | grep -v "^demos/$name/" || true)"
if [[ -n "$bad" ]]; then
  echo "branch demo/$name may change only demos/$name/. These paths are outside it:" >&2
  echo "$bad" >&2
  exit 1
fi
echo "ok: only demos/$name/ changed"
