#!/usr/bin/env bash
# Offline checks for scripts/stage, check-paths, new-demo and publish. No network, no deploy.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp" demos/zz-selftest demos/zz-static demos/zz-api .stage' EXIT
fails=0
ok()   { echo "PASS  $1"; }
bad()  { echo "FAIL  $1"; fails=$((fails + 1)); }
expect_exit() { # <want> <label> <cmd...>
  local want="$1" label="$2"; shift 2
  local got=0
  "$@" > "$tmp/out" 2>&1 || got=$?
  if [[ "$got" == "$want" ]]; then ok "$label"; else bad "$label (exit $got, want $want)"; cat "$tmp/out"; fi
}

# sample demos for the checks below (removed on exit)
mkdir -p demos/zz-static/public demos/zz-api/public demos/zz-api/functions/api
echo '<html><body>static</body></html>' > demos/zz-static/public/index.html
echo '<html><body>api</body></html>' > demos/zz-api/public/index.html
echo 'export const onRequestGet = () => new Response("hi");' > demos/zz-api/functions/api/hello.js

# stage
expect_exit 0 "stage zz-static" scripts/stage zz-static
if [[ -f .stage/public/index.html && ! -e .stage/functions ]]; then ok "zz-static staged without functions"; else bad "zz-static layout"; fi
expect_exit 0 "stage zz-api" scripts/stage zz-api
if [[ -f .stage/public/index.html && -f .stage/functions/api/hello.js ]]; then ok "zz-api staged with functions"; else bad "zz-api layout"; fi
expect_exit 2 "stage rejects Bad_Name" scripts/stage Bad_Name
expect_exit 2 "stage rejects 25-char name" scripts/stage abcdefghijklmnopqrstuvwxy
expect_exit 1 "stage rejects missing demo" scripts/stage no-such-demo

mkdir -p demos/zz-selftest
echo '{"build": "mkdir -p dist && echo built > dist/index.html", "output": "dist"}' > demos/zz-selftest/demo.json
expect_exit 0 "stage runs demo.json build" scripts/stage zz-selftest
if [[ "$(head -1 .stage/public/index.html 2>/dev/null)" == built ]]; then ok "build output staged"; else bad "build output staged"; fi
echo '{"output": "../zz-api/public"}' > demos/zz-selftest/demo.json
expect_exit 1 "stage rejects output outside the demo" scripts/stage zz-selftest

rm demos/zz-selftest/demo.json
mkdir -p demos/zz-selftest/public
echo '<html><BODY>x</BODY></html>' > demos/zz-selftest/public/index.html
expect_exit 0 "stage with no demo.json" scripts/stage zz-selftest
if grep -q "src=\"/_acp/panel.js\" data-demo=\"zz-selftest\" data-repo=\"$(sed -n 's/^REPO=//p' deploy.config)\"" .stage/public/index.html && [[ -f .stage/public/_acp/panel.js ]]; then ok "acp panel injected"; else bad "acp panel injected"; fi
echo '{"acp": false}' > demos/zz-selftest/demo.json
expect_exit 0 "stage with acp false" scripts/stage zz-selftest
if grep -q _acp/panel.js .stage/public/index.html; then ok "acp panel forced on"; else bad "acp panel forced on"; fi
expect_exit 2 "acp-bridge rejects bad name" scripts/acp-bridge Bad_Name
expect_exit 2 "acp-bridge rejects unknown agent" scripts/acp-bridge zz-static --agent nope
expect_exit 0 "acp-bridge chat round trip (fake agent)" node acp/test.js

# check-paths, in a throwaway repo
repo="$tmp/repo"
git init -q -b main "$repo"
(
  cd "$repo"
  git config user.email t@example.com; git config user.name t
  mkdir -p demos/aa demos/b
  echo a > demos/aa/x; echo b > demos/b/y
  git add -A; git commit -qm base
  git switch -qc demo/aa; echo a2 > demos/aa/x; git commit -qam own
  git switch -qc demo/aa-other main; echo b2 > demos/b/y; git commit -qam other
  git switch -qc demo/aa-move main; git mv demos/b/y demos/aa/y; git commit -qm move
  git switch -qc demo/aa-root main; echo r > README.md; git add README.md; git commit -qm root
)
cp_check() { (cd "$repo" && "$root/scripts/check-paths" "$@"); }
expect_exit 0 "check-paths allows own folder" cp_check aa main demo/aa
expect_exit 1 "check-paths blocks another demo's folder" cp_check aa main demo/aa-other
expect_exit 1 "check-paths blocks moving another demo's file in" cp_check aa main demo/aa-move
expect_exit 1 "check-paths blocks root files" cp_check aa main demo/aa-root
expect_exit 2 "check-paths rejects bad name" cp_check A main demo/aa

# new-demo
before="$(git status --porcelain; git branch --list)"
expect_exit 0 "new-demo --dry-run" scripts/new-demo zz-dry --dry-run
after="$(git status --porcelain; git branch --list)"
if [[ "$before" == "$after" && ! -e demos/zz-dry ]]; then ok "new-demo --dry-run changed nothing"; else bad "new-demo --dry-run changed something"; fi
expect_exit 2 "new-demo rejects bad name" scripts/new-demo Bad --dry-run
expect_exit 1 "new-demo refuses existing demo" scripts/new-demo zz-static --dry-run

# publish (validation and dry run only; a real run needs GitHub and Cloudflare)
site="$tmp/site"; mkdir -p "$site"; echo hi > "$site/index.html"
expect_exit 0 "publish --dry-run on a good folder" scripts/publish zz-pub "$site" --dry-run
repo="$(sed -n 's/^REPO=//p' deploy.config)"
if grep -q "in $repo " "$tmp/out"; then ok "publish reads REPO from deploy.config"; else bad "publish reads REPO from deploy.config"; fi
if [[ ! -e demos/zz-pub ]]; then ok "publish --dry-run wrote nothing"; else bad "publish --dry-run wrote something"; fi
expect_exit 2 "publish rejects bad name" scripts/publish Bad_Name "$site" --dry-run
expect_exit 1 "publish rejects a missing folder" scripts/publish zz-pub "$tmp/nope" --dry-run
mkdir -p "$tmp/empty"
expect_exit 1 "publish rejects a folder with no index.html" scripts/publish zz-pub "$tmp/empty" --dry-run
echo SECRET=1 > "$site/.env.local"
expect_exit 1 "publish refuses a folder holding .env files" scripts/publish zz-pub "$site" --dry-run
rm "$site/.env.local"
mkdir -p "$tmp/fn"
expect_exit 0 "publish --dry-run accepts --acp" scripts/publish zz-pub "$site" --acp --dry-run
expect_exit 0 "publish --dry-run accepts --functions" scripts/publish zz-pub "$site" --functions "$tmp/fn" --dry-run

echo
if (( fails )); then echo "$fails check(s) failed"; exit 1; fi
echo "all checks passed"
