#!/usr/bin/env bash
# Build demos/<name> into .stage/ (public/ + optional functions/) for `wrangler pages deploy`.
set -euo pipefail

name="${1:-}"
if [[ ! "$name" =~ ^[a-z][-a-z0-9]{0,22}[a-z0-9]$ ]]; then
  echo "usage: scripts/stage <name>   (name must match ^[a-z][-a-z0-9]{0,22}[a-z0-9]\$)" >&2
  exit 2
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
demo="$root/demos/$name"
stage="$root/.stage"
[[ -d "$demo" ]] || { echo "no such demo: demos/$name" >&2; exit 1; }

out=public
if [[ -f "$demo/demo.json" ]]; then
  build="$(jq -r '.build // empty' "$demo/demo.json")"
  out="$(jq -r '.output // "public"' "$demo/demo.json")"
  if [[ "$out" == /* || "$out" == *..* ]]; then
    echo "demo.json output must be a path inside demos/$name: $out" >&2
    exit 1
  fi
  if [[ -n "$build" ]]; then
    (
      cd "$demo"
      if [[ -f package-lock.json ]]; then npm ci; elif [[ -f package.json ]]; then npm install; fi
      bash -c "$build"
    )
  fi
fi

[[ -d "$demo/$out" ]] || { echo "missing output folder: demos/$name/$out" >&2; exit 1; }

rm -rf "$stage"
mkdir -p "$stage"
cp -R "$demo/$out" "$stage/public"
if [[ -d "$demo/functions" ]]; then
  cp -R "$demo/functions" "$stage/functions"
fi
echo "staged demos/$name -> .stage/"
