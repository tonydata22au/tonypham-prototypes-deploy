#!/usr/bin/env bash
# Build demos/<name> into .stage/ (public/ + optional functions/) for `wrangler pages deploy`.
set -euo pipefail

name="${1:-}"
if [[ ! "$name" =~ ^[a-z][-a-z0-9]{0,22}[a-z0-9]$ ]]; then
  echo "usage: scripts/stage <name>   (name must match ^[a-z][-a-z0-9]{0,22}[a-z0-9]\$)" >&2
  exit 2
fi

here="$(cd "$(dirname "$0")/.." && pwd)"
root="${STAGE_ROOT:-$here}" # scripts/acp-bridge stages a worktree with these (newer) scripts
demo="$root/demos/$name"
stage="$root/.stage"
[[ -d "$demo" ]] || { echo "no such demo: demos/$name" >&2; exit 1; }

out=public
if [[ -f "$demo/demo.json" ]]; then
  build="$(jq -r '.build // empty' "$demo/demo.json")"
  out="$(jq -r '.output // "public"' "$demo/demo.json")"
  if [[ "$out" == /* || "$out" == *..* ]]; then
    echo "demo.json output must be a path inside demos/$name: $out" >&2
    exit 1
  fi
  if [[ -n "$build" ]]; then
    (
      cd "$demo"
      if [[ -f package-lock.json ]]; then npm ci; elif [[ -f package.json ]]; then npm install; fi
      bash -c "$build"
    )
  fi
fi

[[ -d "$demo/$out" ]] || { echo "missing output folder: demos/$name/$out" >&2; exit 1; }

rm -rf "$stage"
mkdir -p "$stage"
cp -R "$demo/$out" "$stage/public"
if [[ -d "$demo/functions" ]]; then
  cp -R "$demo/functions" "$stage/functions"
fi
# Every demo gets the "Edit with AI" panel (acp/panel.js), in index.html only.
{
  mkdir -p "$stage/public/_acp"
  cp "$here/acp/panel.js" "$stage/public/_acp/panel.js"
  repo="$(sed -n 's/^REPO=//p' "$here/deploy.config")"
  tag="<script src=\"/_acp/panel.js\" data-demo=\"$name\" data-repo=\"$repo\" defer></script>"
  index="$stage/public/index.html"
  if [[ -f "$index" ]] && grep -qi '</body>' "$index"; then
    TAG="$tag" perl -0pi -e 's#</body>#$ENV{TAG}\n</body>#i' "$index"
  elif [[ -f "$index" ]]; then
    echo "$tag" >> "$index"
  fi
}
echo "staged demos/$name -> .stage/"
